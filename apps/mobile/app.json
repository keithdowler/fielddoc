{
  "expo": {
    "name": "Proof Packet",
    "slug": "fielddoc-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fielddoc",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.dogwoodenterprises.proofpacket",
      "buildNumber": "1",
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "Proof Packet uses the camera to capture job-site evidence photos.",
        "NSPhotoLibraryUsageDescription": "Proof Packet lets you attach existing photos as job-site evidence.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.dogwoodenterprises.proofpacket",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "@clerk/expo",
      "expo-router",
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Proof Packet uses the camera to capture job-site evidence photos.",
          "photosPermission": "Proof Packet lets you attach existing photos as job-site evidence."
        }
      ],
      "expo-secure-store",
      "expo-document-picker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "95e23198-2f0f-45b1-98f6-4c9d2ef7bbdb"
      }
    }
  }
}
