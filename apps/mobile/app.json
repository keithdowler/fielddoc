{
  "expo": {
    "name": "FieldDoc",
    "slug": "fielddoc-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/fielddoc-icon.png",
    "scheme": "fielddoc",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.dogwoodenterprises.proofpacket",
      "buildNumber": "1",
      "icon": "./assets/brand/fielddoc-icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "FieldDoc uses the camera to capture job-site photos.",
        "NSPhotoLibraryUsageDescription": "FieldDoc lets you attach existing job-site photos.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.dogwoodenterprises.proofpacket",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/brand/fielddoc-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "@clerk/expo",
      "expo-router",
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "cameraPermission": "FieldDoc uses the camera to capture job-site photos.",
          "photosPermission": "FieldDoc lets you attach existing job-site photos."
        }
      ],
      "expo-secure-store",
      "expo-document-picker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "95e23198-2f0f-45b1-98f6-4c9d2ef7bbdb"
      }
    }
  }
}
