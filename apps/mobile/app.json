{
  "expo": {
    "name": "Proof Packet",
    "slug": "fielddoc-mobile",
    "version": "0.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fielddoc",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.fielddoc.mobile",
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "Proof Packet uses the camera to capture job-site evidence photos.",
        "NSPhotoLibraryUsageDescription": "Proof Packet lets you attach existing photos as job-site evidence."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Proof Packet uses the camera to capture job-site evidence photos.",
          "photosPermission": "Proof Packet lets you attach existing photos as job-site evidence."
        }
      ],
      "expo-document-picker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
